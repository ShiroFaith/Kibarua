# ── Server ────────────────────────────────────────────────────────────────
# Port the API listens on. The frontend's API base is configured to point here
# (http://localhost:5050/api). 5000 is often taken by other dev tools, so the
# project defaults to 5050 — keep this in sync with the frontend if you change it.
PORT=5050
# Environment: development | production
NODE_ENV=development

# ── Security ──────────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens. CHANGE THIS in production to a long
# random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-secret-string
# How long an access token stays valid (zeit/ms format: 15m, 1h, 7d, 30d).
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API from the browser.
# Add every URL the frontend is served from. Use * to allow any origin (dev only).
CORS_ORIGINS=http://localhost,http://localhost:5500,http://localhost:5501,http://127.0.0.1:5500,http://127.0.0.1:5501,http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to the backend/ directory).
DATABASE_FILE=./data/kibarua.sqlite

# ── Uploads ──────────────────────────────────────────────────────────────────
# Directory where uploaded avatars / ID documents are stored.
UPLOAD_DIR=./uploads
# Max upload size in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880
