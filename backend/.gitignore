# NOTE: node_modules and .env are intentionally committed per project request.
# .env contains a dev JWT secret - rotate it before any real deployment.
*.log
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
# The pre-seeded demo database IS committed so the app has data out of the box.
!data/kibarua.sqlite
uploads/*
!uploads/.gitkeep
