{
  "name": "kibarua-backend",
  "version": "1.0.0",
  "description": "REST API backend for the Kibarua gig-work marketplace connecting Kenya's informal workforce with employers.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --fresh && node src/db/seed.js"
  },
  "keywords": [
    "kibarua",
    "gig-economy",
    "marketplace",
    "jobs",
    "express",
    "rest-api",
    "jwt"
  ],
  "author": "Kibarua Platform",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  }
}
